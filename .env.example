# Copy to .env and adjust as needed. All values also have working defaults for local dev.

# Backend API (FastAPI)
DATABASE_URL=postgresql+psycopg://desk:desk@localhost:5432/desk
SECRET_KEY=dev-secret-key-change-in-prod
# openssl rand -hex 32  # generate a real one for production
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60
COOKIE_SECURE=false
ENVIRONMENT=development
ANALYTICS_MAX_RANGE_DAYS=366

# Tests (conftest.py reads this; create the database first)
TEST_DATABASE_URL=postgresql+psycopg://desk:desk@localhost:5432/desk_test

# Frontend: API origin used for /api/* rewrites. Baked in at image build time.
# Use http://api:8000 for docker compose, http://localhost:8000 for local `next dev`.
# NOT used on Vercel: there, `/api/*` is routed straight to the backend service
# by vercel.json, so the app has no internal base URL at all.
API_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Vercel (services deployment) — set these in Project Settings > Environment
# Variables, not in a file. Project env vars are available at build time;
# service bindings (none in this project) are not.
# ---------------------------------------------------------------------------
#
# DATABASE_URL   required. Hosted Postgres. Vercel/Neon/Supabase hand out
#                `postgres://…`; SQLAlchemy needs `postgresql+psycopg://…`
#                (swap the scheme). Used at build time by `alembic upgrade head`
#                and at request time by the API.
# SECRET_KEY     required. `openssl rand -hex 32`. Has an insecure default —
#                never ship the default.
# COOKIE_SECURE  set to `true` in production: the site is HTTPS-only, so the
#                session cookie should carry the Secure attribute.
# JWT_ALGORITHM / JWT_EXPIRY_MINUTES / ANALYTICS_MAX_RANGE_DAYS
#                optional, defaults apply.
#
# The backend build command is `alembic upgrade head && python -m app.seed`, so
# every deploy that has DATABASE_URL runs migrations AND inserts the demo users
# from seed/users.json (idempotent — existing rows are skipped).
