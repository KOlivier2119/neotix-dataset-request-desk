# Copy to .env and adjust as needed. All values also have working defaults for local dev.

# Backend API (FastAPI)
DATABASE_URL=postgresql+psycopg://desk:desk@localhost:5432/desk
SECRET_KEY=dev-secret-key-change-in-prod
# openssl rand -hex 32  # generate a real one for production
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60
COOKIE_SECURE=false
ENVIRONMENT=development
ANALYTICS_MAX_RANGE_DAYS=366

# Tests (conftest.py reads this; create the database first)
TEST_DATABASE_URL=postgresql+psycopg://desk:desk@localhost:5432/desk_test

# Frontend: API origin used for /api/* rewrites. Baked in at image build time.
# Use http://api:8000 for docker compose, http://localhost:8000 for local `next dev`.
API_URL=http://localhost:8000
